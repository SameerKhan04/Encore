{
  "expo": {
    "name": "Encore",
    "slug": "Encore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "encore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ENCORE needs the microphone so you can sing challenges and talk to your Online Match opponent."
      }
    },
    "android": {
      "package": "com.encore.party",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ENCORE to access your microphone to capture singing performances."
        }
      ],
      "expo-asset",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow ENCORE to use the microphone for Online Match voice so you can hear and talk to your opponent."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B0E14",
          "defaultChannel": "social"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b32f7f7-e569-4d4f-b2ce-23d4a4645191"
      }
    },
    "owner": "sameerk04"
  }
}
