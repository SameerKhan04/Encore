# Copy to .env and restart Expo (`npx expo start`).
# Never commit real keys.

# Gemini free tier — STT + soft lyrics verify
# https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase — cross-device Online Match + friends + invites (optional; memory demo without these)
# Run in the SQL editor (safe to re-run):
#   supabase/encore_matches.sql
#   supabase/encore_profiles.sql
#   supabase/encore_friend_requests.sql
#   supabase/encore_match_invites.sql
#   supabase/encore_voice_signals.sql
# Production RLS (after enabling Authentication → Providers → Anonymous):
#   supabase/encore_rls.sql
# If create-match fails on abandoned_by, run alone:
#   alter table public.encore_matches add column if not exists abandoned_by text;
#   notify pgrst, 'reload schema';
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional TURN for bad networks (comma-separated URLs)
# EXPO_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
